ifeq ($(OS),Windows_NT)
HOST_OS := windows
else
HOST_OS := $(shell uname -s | tr '[:upper:]' '[:lower:]')
endif

ARCH ?= x86_64

ifeq ($(ARCH),x86_64)
TRIPLE := x86_64-w64-mingw32
else ifeq ($(ARCH),amd64)
TRIPLE := x86_64-w64-mingw32
else ifeq ($(ARCH),i686)
TRIPLE := i686-w64-mingw32
else ifeq ($(ARCH),x86)
TRIPLE := i686-w64-mingw32
else ifeq ($(ARCH),aarch64)
TRIPLE := aarch64-w64-mingw32
else ifeq ($(ARCH),arm64)
TRIPLE := aarch64-w64-mingw32
else
$(error unsupported ARCH '$(ARCH)' (use x86_64, i686 or aarch64))
endif

ifeq ($(origin CC),default)
  ifeq ($(HOST_OS),windows)
    CC := gcc
  else
    CC := $(TRIPLE)-gcc
  endif
endif

ifeq ($(origin WINDRES),undefined)
  ifeq ($(HOST_OS),windows)
    WINDRES := windres
  else
    WINDRES := $(TRIPLE)-windres
  endif
endif

CONFIG ?= release

ifeq ($(CONFIG),release)
CONFIG_CFLAGS := -O2 -s -DNDEBUG
else ifeq ($(CONFIG),debug)
CONFIG_CFLAGS := -O0 -g3 -DDEBUG
else
$(error unsupported CONFIG '$(CONFIG)' (use release or debug))
endif

BUILD_DIR ?= build/$(ARCH)/$(CONFIG)
OBJ_DIR   := $(BUILD_DIR)/obj
BIN       := $(BUILD_DIR)/DNGFix.exe

SRCS := src/main.c src/dng.c src/profile.c
OBJS := $(patsubst src/%.c,$(OBJ_DIR)/%.o,$(SRCS))
DEPS := $(OBJS:.o=.d)

GEN_HEADER   := $(OBJ_DIR)/git_version.h
RES_OBJ      := $(OBJ_DIR)/DNGFix.res.o
MANIFEST_RC  := $(OBJ_DIR)/manifest.rc
MANIFEST_OBJ := $(OBJ_DIR)/manifest.res.o

PROFILE_FILES   := $(wildcard profiles/*.ini)
DIST_PROFILES   := $(patsubst profiles/%,$(BUILD_DIR)/profiles/%,$(PROFILE_FILES))

GIT_VERSION := $(shell git describe --tags --always --dirty --abbrev=7 2>/dev/null)
ifeq ($(strip $(GIT_VERSION)),)
GIT_VERSION := unknown
endif

CPPFLAGS += -DUNICODE -D_UNICODE -D_CRT_SECURE_NO_WARNINGS \
            -Isrc -I$(OBJ_DIR)
CFLAGS   += -std=c11 -Wall -Wextra -Wno-unused-parameter -MMD -MP \
            $(CONFIG_CFLAGS)
LDFLAGS  += -municode -mwindows -static-libgcc
LDLIBS   += -lcomctl32 -lcomdlg32 -lgdi32 -lshell32 -lole32 -luuid
RCFLAGS  += -I src -I res -I $(OBJ_DIR) -DUNICODE -D_UNICODE

.PHONY: all release debug clean distclean run help FORCE

all: $(BIN) $(DIST_PROFILES)

release:
	@$(MAKE) --no-print-directory CONFIG=release all

debug:
	@$(MAKE) --no-print-directory CONFIG=debug all

$(GEN_HEADER): FORCE | $(OBJ_DIR)
	@{ \
		echo '// Generated by the Makefile from git describe. Do not edit.'; \
		echo '#define APP_VERSION L"$(GIT_VERSION)"'; \
		echo '#define APP_VERSION_DIALOG "DNGFix, Version $(GIT_VERSION)"'; \
	} > $@.tmp
	@if [ -f $@ ] && [ "`cat $@`" = "`cat $@.tmp`" ]; then \
		rm -f $@.tmp; \
	else \
		mv -f $@.tmp $@; \
	fi

$(MANIFEST_RC): | $(OBJ_DIR)
	@echo '1 24 "DNGFix.manifest"' > $@

$(OBJ_DIR)/%.o: src/%.c $(GEN_HEADER) | $(OBJ_DIR)
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@

$(RES_OBJ): res/DNGFix.rc $(GEN_HEADER) $(wildcard res/*.ico) | $(OBJ_DIR)
	$(WINDRES) $(RCFLAGS) -i $< -o $@ -O coff

$(MANIFEST_OBJ): $(MANIFEST_RC) res/DNGFix.manifest | $(OBJ_DIR)
	$(WINDRES) $(RCFLAGS) -i $(MANIFEST_RC) -o $@ -O coff

$(BIN): $(OBJS) $(RES_OBJ) $(MANIFEST_OBJ)
	$(CC) $(LDFLAGS) -o $@ $^ $(LDLIBS)

$(BUILD_DIR)/profiles/%: profiles/% | $(BUILD_DIR)/profiles
	cp -f $< $@

$(OBJ_DIR) $(BUILD_DIR)/profiles:
	mkdir -p $@

clean:
	rm -rf $(BUILD_DIR)

distclean:
	rm -rf build

run: $(BIN)
	$(BIN)

-include $(DEPS)

FORCE:
